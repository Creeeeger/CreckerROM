+.method public static isProVideoTeleResolutionSupported(Lcom/sec/android/app/camera/interfaces/Resolution;I)Z
+    .locals 2
+
+    # Exynos990 tele streams cannot run the Pro Video 24 FPS modes.
+    const/4 v0, 0x2
+
+    if-eq p1, v0, :check_tele_fps
+
+    const/4 v0, 0x3
+
+    if-ne p1, v0, :tele_resolution_supported
+
+    :check_tele_fps
+    invoke-virtual {p0}, Lcom/sec/android/app/camera/interfaces/Resolution;->getMaxFps()I
+
+    move-result v0
+
+    const/16 v1, 0x18
+
+    if-ne v0, v1, :tele_resolution_supported
+
+    invoke-virtual {p0}, Lcom/sec/android/app/camera/interfaces/Resolution;->getWidth()I
+
+    move-result v0
+
+    const/16 v1, 0x780
+
+    if-eq v0, v1, :tele_resolution_unsupported
+
+    const/16 v1, 0xf00
+
+    if-eq v0, v1, :tele_resolution_unsupported
+
+    const/16 v1, 0x1e00
+
+    if-eq v0, v1, :tele_resolution_unsupported
+
+    :tele_resolution_supported
+    const/4 v0, 0x1
+
+    return v0
+
+    :tele_resolution_unsupported
+    const/4 v0, 0x0
+
+    return v0
 .end method

