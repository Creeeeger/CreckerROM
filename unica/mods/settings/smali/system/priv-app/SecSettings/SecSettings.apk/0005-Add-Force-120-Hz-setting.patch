 .end method
diff --git a/smali_classes4/com/samsung/android/settings/display/HighRefreshRateFragment$1.smali b/smali_classes4/com/samsung/android/settings/display/HighRefreshRateFragment$1.smali
--- a/smali_classes4/com/samsung/android/settings/display/HighRefreshRateFragment$1.smali
+++ b/smali_classes4/com/samsung/android/settings/display/HighRefreshRateFragment$1.smali
@@ -90,6 +90,16 @@
     :cond_1
     iget-object p1, p0, Lcom/samsung/android/settings/display/HighRefreshRateFragment$1;->this$0:Lcom/samsung/android/settings/display/HighRefreshRateFragment;

+    iget-object p2, p1, Lcom/samsung/android/settings/display/HighRefreshRateFragment;->mContext:Landroid/content/Context;
+
+    invoke-static {p2}, Lio/mesalabs/unica/settings/display/Force120HzPreferenceController;->isEnabled(Landroid/content/Context;)Z
+
+    move-result p2
+
+    # Keep the high-speed preference for resuming after power saving ends.
+    # The display service still honors its higher-priority low-power votes.
+    if-nez p2, :cond_2
+
     iget p2, p1, Lcom/samsung/android/settings/display/HighRefreshRateFragment;->mMode:I

     if-eqz p2, :cond_2
